# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign login tokens (set a long random string in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Port of the Socket.IO game server that boots together with the Next.js server.
# Browser traffic reaches it via the /socket.io rewrite in next.config.ts.
GAME_SERVER_PORT=4001

# Optional: Redis mirrors the live queue + turn lock so they survive restarts.
# When unset the queue lives purely in process memory.
# REDIS_URL=redis://127.0.0.1:6379

# Optional: connect the browser straight to a standalone game server.
# Use the public HTTPS URL on Vercel (for example, https://game.example.com).
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4001
